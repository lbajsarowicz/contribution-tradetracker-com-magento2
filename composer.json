{
    "name": "tradetracker-com/magento2",
    "description": "TradeTracker integration for Magento 2",
    "type": "magento2-module",
    "version": "1.9.0",
    "require": {
        "magento/framework": ">=102.0.3",
        "php": ">=8.2.0"
    },
    "license": [
        "BSD-2-Clause"
    ],
    "extra": {
        "magmodules": {
            "links": {
                "docs": {
                    "en": "https://www.magmodules.eu/help/magento2-tradetracker"
                }
            }
        }
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "TradeTracker\\Connect\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
